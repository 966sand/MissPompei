# 复制本文件为 .env，并填入你的 DeepSeek API Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 以下为可选配置，默认即可
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
PORT=3000

# 埋点存储（可选）。不配也能跑：事件会以 [ev] / [hit] 结构化行打进日志，
# 仍可看，只是不能聚合。配上才会写入 Redis，供 tools/analytics.mjs 出日报。
# 去 https://console.upstash.com 建一个 Regional（免费档）Redis，区域选
# ap-southeast-1（新加坡，与 Render 同区），详情页的 REST API 区块可整段复制这两行。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 事件保留天数在 server.js 里是常量 EV_RETENTION_DAYS=90，不走环境变量。
